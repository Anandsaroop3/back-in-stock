# Copy to .env for local runs (never commit the real file).

# --- required ---
# Optional. Unset = embedded PostgreSQL stored in DATA_DIR (default ./data; /data in Docker).
# Set it to use real PostgreSQL (recommended for several instances).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/encore
STOCK_API_URL=                                                             # from the harness sign-up (GET {url}/{sku})
STOCK_API_KEY=
RESEND_API_KEY=
RESEND_BASE_URL=                                                           # NOT api.resend.com
WEBHOOK_SECRET=
ADMIN_PASSWORD=choose-a-long-passphrase

# --- recommended ---
NODE_ENV=production
PUBLIC_URL=https://your-app.up.railway.app
STORE_NAME=Northline Goods
STORE_URL=https://example.com/shop          # where the email button goes when the product has no URL
EMAIL_FROM=Encore <alerts@yourdomain.com>

# --- optional tuning (defaults shown) ---
# PORT=3000
# TRUST_PROXY=1                  # proxy hops in front of the app; 0 when none
# DATABASE_SSL=false
# EMBED_ALLOWED_ORIGINS=*        # space-separated origins allowed to frame /embed
# MAX_ATTEMPTS=8                 # send attempts before a request is marked failed
# RECONCILE_INTERVAL_MS=30000
# MAX_OPEN_PER_EMAIL=25
# MAX_PER_EMAIL_PER_DAY=30
# BAN_THRESHOLD=20               # scanner strikes per minute before a 30 minute ban
# GUARD_ENABLED=true
